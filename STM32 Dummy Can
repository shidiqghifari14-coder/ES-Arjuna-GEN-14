/*
 * Cocok dengan ESP32_Telemetry_TWAI.ino:
 * standard ID 1..10, DLC=8, byte 0..3 uint32 value,
 * byte 4..7 uint32 sequence, little-endian.
 *
 * Clock mengikuti versi sederhana yang sudah berhasil:
 * HSI 16MHz /8 *128 /4 = SYSCLK 64MHz.
 * AHB /8 = HCLK 8MHz; APB1 /1 = PCLK1 8MHz.
 * CAN 8MHz / (1 * (1 + 13 + 2)) = 500kbps, 16TQ, sample87.5%.
 * Sumber HSI internal: HSE_VALUE tidak dipakai untuk clock ini.
 */
static uint32_t ReadU32LE(const uint8_t *p)
{
  /* Cast sebelum shift mencegah masalah signed shift. */
  return (uint32_t)p[0] | ((uint32_t)p[1] << 8)
       | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
}

/* Update setiap ID segera, sehingga frame yang diterima langsung terlihat.
   Global antar-ID dapat berbeda sequence selama pengiriman satu set (180ms).
   Power di ESP tetap dihitung dari V dan I dalam satu set yang sama. */
static void Telemetry_UpdateSignal(uint32_t index, uint32_t value)
{
  switch (index)
  {
    case 0: battery_voltage_V = value / 1000.0f; break;
    case 1: battery_current_A = value / 1000.0f; break;
    case 2: battery_temperature_C = value / 1000.0f; break;
    case 3: battery_power_W = (float)value; break;
    case 4: throttle_percent = (float)value; break;
    case 5: brake_percent = (float)value; break;
    case 6: suspension_travel_mm = value / 100.0f; break;
    case 7: motor_rpm = (float)value; break;
    case 8: wheel_rpm = value / 100.0f; break;
    case 9: esp32_uptime_ms = value; break;
    default: break;
  }
}

static void Telemetry_AcceptFrame(const CAN_RxHeaderTypeDef *rx,
                                  const uint8_t *data, uint32_t now)
{
  if (rx->IDE != CAN_ID_STD || rx->RTR != CAN_RTR_DATA ||
      rx->DLC != 8U || rx->StdId < 1U || rx->StdId > TELEMETRY_SIGNALS)
  {
    ++can_invalid_count;
    return;
  }
  const uint32_t index = rx->StdId - 1U;
  const uint32_t seq = ReadU32LE(data + 4);
  ++can_rx_count;
  can_last_id = rx->StdId;
  can_last_sequence = seq;
  can_seen_mask |= 1UL << index;

  if (!have_sequence || seq != can_snapshot_sequence)
  {
    /* Frame hilang tidak dicampur dengan set berikutnya. */
    if (have_sequence && can_snapshot_mask != TELEMETRY_ALL_IDS)
      ++can_partial_drop_count;
    have_sequence = 1;
    published_sequence = 0;
    can_snapshot_sequence = seq;
    can_snapshot_mask = 0;
  }

  pending_values[index] = ReadU32LE(data);
  Telemetry_UpdateSignal(index, pending_values[index]);
  can_signal_rx_ms[index] = now;
  can_snapshot_mask |= 1UL << index;
  if (can_snapshot_mask == TELEMETRY_ALL_IDS && !published_sequence)
  {
    published_sequence = 1; // Duplikat tidak menghitung set lengkap kedua.
    can_last_complete_ms = now;
    ++can_complete_snapshot_count;
  }
}

static void Telemetry_ServiceFreshness(uint32_t now)
{
  /* Fresh jika semua ID pernah diterima dan masing-masing berumur <=1s.
     Jika stale, nilai terakhir tetap tersimpan. Delta aman saat tick wrap. */
  uint32_t fresh = (can_seen_mask == TELEMETRY_ALL_IDS);
  for (uint32_t i = 0; i < TELEMETRY_SIGNALS; ++i)
    if ((uint32_t)(now - can_signal_rx_ms[i]) > TELEMETRY_TIMEOUT_MS) fresh = 0;
  can_data_fresh = fresh;
}

static void CAN_Receiver_Start(void)
{
  CAN_FilterTypeDef filter = {0};
  /* Filter menerima semua frame untuk diagnosis. Aplikasi memeriksa standard/data/ID/DLC. */
  filter.FilterBank = 0;
  filter.FilterMode = CAN_FILTERMODE_IDMASK;
  filter.FilterScale = CAN_FILTERSCALE_32BIT;
  filter.FilterIdHigh = 0;
  filter.FilterIdLow = 0;
  filter.FilterMaskIdHigh = 0;
  filter.FilterMaskIdLow = 0; // Terima semua untuk diagnosis frame mentah.
  filter.FilterFIFOAssignment = CAN_FILTER_FIFO0;
  filter.FilterActivation = ENABLE;
  filter.SlaveStartFilterBank = 14;
  can_hclk_hz = HAL_RCC_GetHCLKFreq();
  can_pclk1_hz = HAL_RCC_GetPCLK1Freq();
  can_btr = hcan1.Instance->BTR;
  uint32_t brp = (can_btr & 0x3FFU) + 1U;
  uint32_t bs1 = ((can_btr >> 16) & 0xFU) + 1U;
  uint32_t bs2 = ((can_btr >> 20) & 7U) + 1U;
  can_bitrate = can_pclk1_hz / (brp * (1U + bs1 + bs2));
  if (can_pclk1_hz != 8000000U || can_bitrate != 500000U) { can_fatal_reason = 1; Error_Handler(); }
  if (HAL_CAN_ConfigFilter(&hcan1, &filter) != HAL_OK)
    { can_fatal_reason = 2; Error_Handler(); }
  if (HAL_CAN_Start(&hcan1) != HAL_OK)
    { can_fatal_reason = 3; Error_Handler(); }
}

static void CAN_Receiver_Poll(void)
{
  /* Baca overrun sebelum melepas frame FIFO. */
  if (__HAL_CAN_GET_FLAG(&hcan1, CAN_FLAG_FOV0))
  {
    ++can_fifo_overrun_count;
    __HAL_CAN_CLEAR_FLAG(&hcan1, CAN_FLAG_FOV0);
  }
  for (uint32_t i = 0; i < 16U; ++i)
  {
    if (HAL_CAN_GetRxFifoFillLevel(&hcan1, CAN_RX_FIFO0) == 0U) break;
    CAN_RxHeaderTypeDef rx;
    uint8_t data[8];
    if (HAL_CAN_GetRxMessage(&hcan1, CAN_RX_FIFO0, &rx, data) != HAL_OK) break;
    ++can_any_rx_count;
    can_raw_last_id = rx.IDE == CAN_ID_STD ? rx.StdId : rx.ExtId;
    can_raw_last_dlc = rx.DLC;
    can_raw_last_ide = rx.IDE;
    can_raw_last_rtr = rx.RTR;
    for (uint32_t k = 0; k < 8U; ++k)
      can_raw_last_data[k] = (rx.RTR == CAN_RTR_DATA && k < rx.DLC) ? data[k] : 0;
    Telemetry_AcceptFrame(&rx, data, HAL_GetTick());
  }
  Telemetry_ServiceFreshness(HAL_GetTick());
  can_error_code = HAL_CAN_GetError(&hcan1);
  can_esr = hcan1.Instance->ESR;
  can_tx_error_counter = (can_esr >> 16) & 0xFFU;
  can_rx_error_counter = (can_esr >> 24) & 0xFFU;
  can_last_error_code = (can_esr >> 4) & 7U;
  can_bus_off = (can_esr >> 2) & 1U;
}

